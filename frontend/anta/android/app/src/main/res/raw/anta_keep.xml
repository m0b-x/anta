<?xml version="1.0" encoding="utf-8"?>
<!-- Resources the release shrinker must not drop. `ic_alert` is the status-bar
     icon of every event alert, and everything that posts one finds it by
     name, at run time: `kAlertSmallIcon` in Dart, which both alert plugins
     resolve from the string, and `SessionChip.kt`. That is a reference the
     shrinker cannot see. The Quick Settings tile (AndroidManifest.xml) and
     the launcher shortcut (res/xml/shortcuts.xml) name the drawable as a
     resource too, but the alerts must not lean on those two staying as they
     are: this entry holds the icon whatever becomes of them. Without it a
     release build can ship with no `ic_alert`, and every notification and
     alarm then fails silently while a debug build (no shrinking) works.

     `default_web_client_id` is the web OAuth client the google-services
     plugin writes from google-services.json; google_sign_in_android reads it
     with `getIdentifier`, so the shrinker dropped it too, and every release
     build failed Google sign-in before asking Android for an account
     (2026-11-07). The plugin keeps it itself from 7.2.16, in a
     `res/raw/keep.xml`.

     That is why this file is not called keep.xml: an app resource overrides a
     library resource of the same name, so a `raw/keep.xml` here silently
     replaced every dependency's own keep list. Keep the name unique. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_alert,@string/default_web_client_id" />
