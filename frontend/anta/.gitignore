# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase config — machine-local, holds project ids and API keys.
# Regenerate on a fresh clone with:  flutterfire configure --platforms=android,ios
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
/lib/firebase_options.dart
/firebase.json
/.firebaserc
# The same files wherever they land: a copy dropped one directory off (or
# spelled with an underscore) is still a credentials file and must never be
# staged.
**/google-services.json
**/google_services.json
**/GoogleService-Info.plist
**/GoogleService-Info*.plist
# Signing material and service-account keys.
**/key.properties
*.jks
*.keystore
**/*service-account*.json
**/*serviceAccount*.json

# The alarm fork's own test run (cd packages/alarm && flutter test) writes these; the package never shipped them.
packages/alarm/build/
packages/alarm/pubspec.lock
packages/alarm/example/pubspec.lock
