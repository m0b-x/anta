{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "workflowSizeGuideline": "small",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v node >/dev/null 2>&1; then node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard.js\"; fi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v node >/dev/null 2>&1; then node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard.js\"; fi",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(dart analyze *)",
      "Bash(dart format *)",
      "Bash(dart run *)",
      "Bash(dart test *)",
      "Bash(flutter test *)",
      "Bash(flutter gen-l10n)",
      "Bash(flutter pub get)",
      "Bash(flutter --version)",
      "Bash(flutter devices)",
      "Bash(flutter build *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git grep *)",
      "Bash(git blame *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(cd *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(tr *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(diff *)",
      "Bash(echo *)",
      "Bash(date *)",
      "Bash(mkdir -p *)",
      "Bash(magick *)",
      "Bash(./tool/qa/qa *)",
      "Bash(tool/qa/qa *)",
      "Bash(./tool/qa/qa.cmd *)",
      "Bash(tool/qa/qa.cmd *)",
      "Bash(dart run tool/qa/qa.dart *)",
      "Bash(./tool/release/release doctor*)",
      "Bash(adb devices*)",
      "Bash(adb -s * shell getprop *)",
      "Bash(adb -s * shell dumpsys *)",
      "Bash(adb -s * shell pm list *)",
      "Bash(adb -s * shell pm path *)",
      "Bash(adb -s * shell wm size)",
      "Bash(adb -s * shell wm density)",
      "Bash(adb -s * logcat *)",
      "Bash(adb -s * emu avd name)",
      "Bash(emulator -list-avds)",
      "Bash(emulator -version)",
      "Bash(avdmanager list *)",
      "PowerShell(dart analyze *)",
      "PowerShell(dart format *)",
      "PowerShell(dart run *)",
      "PowerShell(flutter test *)",
      "PowerShell(flutter gen-l10n)",
      "PowerShell(flutter pub get)",
      "PowerShell(flutter devices)",
      "PowerShell(flutter build *)",
      "PowerShell(git status *)",
      "PowerShell(git log *)",
      "PowerShell(git diff *)",
      "PowerShell(git show *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Select-String *)",
      "PowerShell(Measure-Object *)",
      "PowerShell(Get-Process *)",
      "PowerShell(Get-CimInstance *)",
      "PowerShell(Get-Counter *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Set-Location *)",
      "PowerShell(cd *)",
      "PowerShell(tool/qa/qa.cmd *)",
      "PowerShell(./tool/qa/qa.cmd *)",
      "PowerShell(tool\\qa\\qa.cmd *)",
      "PowerShell(.\\tool\\qa\\qa.cmd *)",
      "PowerShell(& tool\\qa\\qa.cmd *)",
      "PowerShell(& .\\tool\\qa\\qa.cmd *)",
      "PowerShell(tool\\\\qa\\\\qa.cmd *)",
      "PowerShell(tool/release/release.cmd doctor*)",
      "PowerShell(adb devices*)",
      "PowerShell(adb -s * shell getprop *)",
      "PowerShell(adb -s * shell dumpsys *)",
      "PowerShell(adb -s * shell pm list *)",
      "PowerShell(adb -s * logcat *)",
      "PowerShell(adb -s * emu avd name)",
      "PowerShell(emulator -list-avds)",
      "PowerShell(emulator -version)",
      "PowerShell(avdmanager list *)"
    ],
    "deny": [
      "Bash(adb uninstall*)",
      "Bash(adb -s * uninstall *)",
      "Bash(adb shell pm clear*)",
      "Bash(adb -s * shell pm clear*)",
      "Bash(adb shell pm uninstall*)",
      "Bash(adb -s * shell pm uninstall*)",
      "Bash(adb shell rm *)",
      "Bash(adb -s * shell rm *)",
      "Bash(adb -s * shell run-as * rm *)",
      "Bash(adb emu kill*)",
      "Bash(adb -s * emu kill*)",
      "Bash(adb reboot*)",
      "Bash(adb -s * reboot*)",
      "Bash(adb kill-server*)",
      "Bash(avdmanager delete *)",
      "Bash(avdmanager * delete *)",
      "Bash(emulator * -wipe-data*)",
      "Bash(emulator -wipe-data*)",
      "Bash(rm *Pixel_9_Pro*)",
      "Bash(rm *.android/avd*)",
      "Bash(taskkill * qemu*)",
      "Bash(taskkill * emulator*)",
      "PowerShell(adb uninstall*)",
      "PowerShell(adb -s * uninstall *)",
      "PowerShell(adb shell pm clear*)",
      "PowerShell(adb -s * shell pm clear*)",
      "PowerShell(adb -s * shell pm uninstall*)",
      "PowerShell(adb shell rm *)",
      "PowerShell(adb -s * shell rm *)",
      "PowerShell(adb emu kill*)",
      "PowerShell(adb -s * emu kill*)",
      "PowerShell(adb reboot*)",
      "PowerShell(adb -s * reboot*)",
      "PowerShell(adb kill-server*)",
      "PowerShell(avdmanager delete *)",
      "PowerShell(avdmanager * delete *)",
      "PowerShell(emulator * -wipe-data*)",
      "PowerShell(Remove-Item *Pixel_9_Pro*)",
      "PowerShell(Remove-Item *.android\\avd*)",
      "PowerShell(Stop-Process * qemu*)",
      "PowerShell(Stop-Process * emulator*)",
      "PowerShell(taskkill * qemu*)",
      "PowerShell(taskkill * emulator*)"
    ]
  }
}
